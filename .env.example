# ---- Site ----------------------------------------------------------------------------------------------
# Public origin, no trailing slash. Baked in at build time: rebuild after changing it. Must be https for live checkout.
NEXT_PUBLIC_SITE_URL=https://norvigate.com

# Search engines are told NOT to index the site unless this is exactly "true".
# Leave it false until real, verified content replaces the samples.
NORVIGATE_ALLOW_INDEXING=false
# Optional override of src/config/visibility.ts: live | beta | all (rebuild after changing)
# NORVIGATE_VISIBILITY=all

# Where submissions and orders are stored. Must be a persistent, writable volume (the Docker kit uses /data).
NORVIGATE_DATA_DIR=.data

# Optional: a webhook URL that gets "a new submission/paid order arrived" pings (event name, record id, time; no personal data).
# NORVIGATE_WEBHOOK_URL=

# Test-only override of the exchange-rate endpoint (leave unset in production)
# NORVIGATE_RATES_URL=

# ---- Store ---------------------------------------------------------------------------------------------
# request = browse, cart, order REQUEST form, no payment (the launch setting).
# live    = online checkout. It refuses to open until `npm run store:check` reports ready.
STORE_MODE=request

# Payment provider for live mode.
PAYMENT_PROVIDER=iyzico
# IYZICO_API_KEY=
# IYZICO_SECRET_KEY=
# IYZICO_SANDBOX=true                 # true uses https://sandbox-api.iyzipay.com; remove for production
# IYZICO_BASE_URL=                    # optional override
# IYZICO_DEFAULT_IDENTITY=            # optional: identity number sent to iyzico when the buyer does not give one

# TEST-ONLY switches. They are refused in production by the readiness check.
# STORE_ALLOW_SAMPLE=1
# STORE_ALLOW_MOCK=1
